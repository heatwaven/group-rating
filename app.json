{
  "expo": {
    "name": "Group Rating",
    "slug": "group-rating",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.grouprating"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.grouprating"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlaube Zugriff auf deine Fotos, um ein Profilbild auszuwählen.",
          "cameraPermission": "Erlaube Zugriff auf die Kamera, um ein Profilbild aufzunehmen."
        }
      ]
    ],
    "scheme": "grouprating"
  }
}
